# Password the Direção types to open the site
APP_PASSWORD=

# Public URL of the site. SvelteKit rejects form submissions if this doesn't match.
ORIGIN=https://presencas.ceist.pt

# iCal feed with the rehearsals and concerts (the published Outlook calendar, ending in calendar.ics)
ICAL_URL=
# Every event in the feed is listed. Optionally, events whose title matches this regular expression
# (case-insensitive) are left out. An event is also left out if its title or description in the calendar
# says "sem presenças".
ICAL_EXCLUDE=game night|praia

# Notion internal integration token (https://www.notion.so/profile/integrations).
# Leave empty in development to use sample members and a local JSON file instead of Notion.
NOTION_TOKEN=
# "Dados dos Membros" database
NOTION_MEMBERS_DB=321419a3db6c80f49ef4da9005fb8d11
# Attendance database, prepared with `bun run setup-notion <database or page URL>`
NOTION_ATTENDANCE_DB=
